diff --git a/packages/front-core/components/JsonSchema/elements/IgrantCredential/index.jsx b/packages/front-core/components/JsonSchema/elements/IgrantCredential/index.jsx
new file mode 100644
index 00000000..f3ba4296
--- /dev/null
+++ b/packages/front-core/components/JsonSchema/elements/IgrantCredential/index.jsx
@@ -0,0 +1,275 @@
+import React from 'react';
+import { useDispatch } from 'react-redux';
+import * as clipboard from 'clipboard-polyfill';
+import cleenDeep from 'clean-deep';
+import QRCode from 'qrcode.react';
+import { Typography, Button } from '@mui/material';
+import makeStyles from '@mui/styles/makeStyles';
+import EastIcon from '@mui/icons-material/East';
+import DoneIcon from '@mui/icons-material/Done';
+import ContentCopyIcon from '@mui/icons-material/ContentCopy';
+import OpenInNewIcon from '@mui/icons-material/OpenInNew';
+import ElementContainer from 'components/JsonSchema/components/ElementContainer';
+import ProgressLine from 'components/Preloader/ProgressLine';
+import { getExternalReaderData } from 'application/actions/task';
+import diff from 'helpers/diff';
+
+/**
+ * igrant.credential — wallet QR code for an iGrant.io OpenID4VC exchange.
+ *
+ * Props (SchemaForm renders the control as <FormControl {...schema} {...props} />,
+ * so schema knobs arrive as top-level props next to the EditScreen props):
+ * - value: object prefilled server-side, { uri, exchangeId }; the poll result is
+ *   written back as value.result. May be undefined until the server fills it.
+ * - onChange(newValue): writes the field value into the document (diff-guarded,
+ *   StripeKYC idiom).
+ * - actions: EditScreen actions bag; only handleNextStep() is used here.
+ * - hidden, required, error, width, noMargin: standard element props.
+ *
+ * Schema knobs (all optional): mode ('issue' | 'verify', default 'verify'),
+ * checkService (default 'igrant'), pollInterval (ms, default 3000),
+ * autoAdvance (default true), title, pendingText, successText.
+ *
+ * Status polling goes through POST /external_reader (getExternalReaderData in
+ * application/actions/task) with body { service, method, extraParams: { exchangeId } }.
+ * That route forwards client `extraParams` unchanged to the external-reader
+ * provider (ProviderMethodArgs.extraParams) and resolves with the provider
+ * payload directly: { flow, exchangeId, status, done, accepted?, verified?,
+ * claims?, holder? }. The document-scoped actions.externalReaderCheck /
+ * POST /documents/:id/external-reader/check path is not used because it drops
+ * client extraParams and builds nonUserFilter from the schema property filters.
+ */
+
+const DEFAULT_POLL_INTERVAL = 3000;
+
+const useStyles = makeStyles(() => ({
+  root: {
+    border: '1px solid #E7EEF3',
+    padding: 32,
+    marginBottom: 32
+  },
+  description: {
+    fontWeight: 400,
+    fontSize: 28,
+    lineHeight: '32px',
+    marginBottom: 24
+  },
+  sample: {
+    fontWeight: 400,
+    fontSize: 16,
+    lineHeight: '24px',
+    marginBottom: 32
+  },
+  qrWrapper: {
+    backgroundColor: '#F1F1F1',
+    padding: 24,
+    display: 'flex',
+    justifyContent: 'center',
+    marginBottom: 24
+  },
+  qrCode: {
+    width: 220,
+    height: 220,
+    backgroundColor: '#fff',
+    padding: 24,
+    boxSizing: 'border-box'
+  },
+  buttonsWrapper: {
+    display: 'flex',
+    alignItems: 'center',
+    gap: 16,
+    marginBottom: 24
+  },
+  copyButton: {
+    fontSize: 13,
+    backgroundColor: '#F1F1F1',
+    padding: '10px 30px',
+    borderRadius: 20
+  }
+}));
+
+const IgrantCredential = ({
+  required,
+  error,
+  width,
+  noMargin,
+  hidden,
+  value,
+  onChange,
+  actions,
+  mode = 'verify',
+  checkService = 'igrant',
+  pollInterval = DEFAULT_POLL_INTERVAL,
+  autoAdvance = true,
+  title,
+  pendingText,
+  successText
+}) => {
+  const classes = useStyles();
+  const dispatch = useDispatch();
+  const [copied, setCopied] = React.useState(false);
+  const [response, setResponse] = React.useState(value?.result || null);
+  const [success, setSuccess] = React.useState(!!value?.result?.done);
+  const [checkError, setCheckError] = React.useState(null);
+  const interval = React.useRef(null);
+  const polling = React.useRef(false);
+  const advanced = React.useRef(!!value?.result?.done);
+
+  const uri = value?.uri;
+  const exchangeId = value?.exchangeId;
+
+  const titleText =
+    title || (mode === 'issue' ? 'Receive your credential' : 'Present your credential');
+  const pendingMessage =
+    pendingText || 'Scan the QR code with your wallet app. The status is checked automatically.';
+  const successMessage = successText || 'Wallet exchange completed successfully.';
+
+  const handleCopy = React.useCallback(() => {
+    clipboard.writeText(uri).then(() => {
+      setCopied(true);
+      setTimeout(() => {
+        setCopied(false);
+      }, 2000);
+    });
+  }, [uri]);
+
+  const checkStatus = React.useCallback(async () => {
+    if (polling.current || !exchangeId) return;
+
+    polling.current = true;
+
+    const result = await dispatch(
+      getExternalReaderData({
+        service: checkService,
+        method: mode === 'issue' ? 'checkCredentialStatus' : 'checkPresentationStatus',
+        extraParams: { exchangeId }
+      })
+    );
+
+    polling.current = false;
+
+    if (result instanceof Error) {
+      setCheckError(result.message);
+      return;
+    }
+
+    setCheckError(null);
+    setResponse(result);
+
+    if (result?.done) {
+      clearInterval(interval.current);
+      setSuccess(true);
+    }
+  }, [dispatch, checkService, mode, exchangeId]);
+
+  React.useEffect(() => {
+    if (!exchangeId || success) return undefined;
+
+    checkStatus();
+
+    interval.current = setInterval(checkStatus, pollInterval);
+
+    return () => {
+      clearInterval(interval.current);
+    };
+  }, [checkStatus, exchangeId, success, pollInterval]);
+
+  React.useEffect(() => {
+    return () => {
+      clearInterval(interval.current);
+    };
+  }, []);
+
+  React.useEffect(() => {
+    if (!response?.done) return;
+
+    const body = { ...value, result: response };
+
+    const diffs = diff(cleenDeep(value) || null, cleenDeep(body) || null);
+
+    if (!diffs) return;
+
+    onChange(body);
+  }, [onChange, response, value]);
+
+  React.useEffect(() => {
+    if (!success || !autoAdvance || advanced.current) return undefined;
+
+    advanced.current = true;
+
+    const timer = setTimeout(() => actions.handleNextStep(), 1000);
+
+    return () => {
+      clearTimeout(timer);
+    };
+  }, [success, autoAdvance, actions]);
+
+  if (hidden) return null;
+
+  return (
+    <ElementContainer required={required} error={error} width={width} noMargin={noMargin}>
+      {success ? (
+        <>
+          <Typography variant={'h3'} className={classes.description}>
+            {titleText}
+          </Typography>
+          <Typography className={classes.sample}>{successMessage}</Typography>
+
+          <Button
+            variant="contained"
+            color="primary"
+            endIcon={<EastIcon />}
+            onClick={() => actions.handleNextStep()}
+          >
+            {'Continue'}
+          </Button>
+        </>
+      ) : null}
+
+      {!success && !uri ? (
+        <>
+          <ProgressLine loading={true} />
+          <Typography className={classes.sample}>{'Waiting for exchange data...'}</Typography>
+        </>
+      ) : null}
+
+      {!success && uri ? (
+        <div className={classes.root}>
+          <Typography variant={'h3'} className={classes.description}>
+            {titleText}
+          </Typography>
+          <Typography className={classes.sample}>{pendingMessage}</Typography>
+
+          <div className={classes.qrWrapper}>
+            <QRCode value={uri} className={classes.qrCode} renderAs={'svg'} />
+          </div>
+
+          <div className={classes.buttonsWrapper}>
+            <Button
+              variant="contained"
+              color="primary"
+              component="a"
+              href={uri}
+              startIcon={<OpenInNewIcon />}
+            >
+              {'Open in wallet'}
+            </Button>
+            <Button
+              className={classes.copyButton}
+              onClick={handleCopy}
+              startIcon={copied ? <DoneIcon size={16} /> : <ContentCopyIcon />}
+            >
+              {copied ? 'Copied' : 'Copy link'}
+            </Button>
+          </div>
+
+          <ProgressLine loading={true} />
+
+          {checkError ? <Typography color="error">{checkError}</Typography> : null}
+        </div>
+      ) : null}
+    </ElementContainer>
+  );
+};
+
+export default IgrantCredential;
