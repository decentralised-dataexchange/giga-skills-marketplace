    "finishBtn": "Continue",
    "forceRedirect": true,
    "properties": {
     "apply": {
      "type": "object",
      "description": "Open positions",
      "properties": {
       "role": {
        "type": "string",
        "description": "Which role are you applying for?",
        "control": "radio.group",
        "checkRequired": "() => true",
        "items": [
         {
          "id": "Registry Operations Coordinator",
          "title": "Registry Operations Coordinator — keep the national registers running"
         },
         {
          "id": "Public Services Analyst",
          "title": "Public Services Analyst — measure and improve citizen services"
         },
         {
          "id": "Junior Data Engineer",
          "title": "Junior Data Engineer — build the data pipelines behind the portals"
         }
        ]
       },
       "message": {
        "type": "string",
        "description": "Message to the hiring team (optional)"
       }
      }
     }
    }
   },
   "jsonSchemaRaw": "{\n    \"title\": \"Choose a role\",\n    \"type\": \"object\",\n    \"pdfRequired\": false,\n    \"signRequired\": false,\n    \"showNextTaskButton\": false,\n    \"finishBtn\": \"Continue\",\n    \"forceRedirect\": true,\n    \"properties\": {\n        \"apply\": {\n            \"type\": \"object\",\n            \"description\": \"Open positions\",\n            \"properties\": {\n                \"role\": {\n                    \"type\": \"string\",\n                    \"description\": \"Which role are you applying for?\",\n                    \"control\": \"radio.group\",\n                    \"checkRequired\": \"() => true\",\n                    \"items\": [\n                        {\n                            \"id\": \"Registry Operations Coordinator\",\n                            \"title\": \"Registry Operations Coordinator \\u2014 keep the national registers running\"\n                        },\n                        {\n                            \"id\": \"Public Services Analyst\",\n                            \"title\": \"Public Services Analyst \\u2014 measure and improve citizen services\"\n                        },\n                        {\n                            \"id\": \"Junior Data Engineer\",\n                            \"title\": \"Junior Data Engineer \\u2014 build the data pipelines behind the portals\"\n                        }\n                    ]\n                },\n                \"message\": {\n                    \"type\": \"string\",\n                    \"description\": \"Message to the hiring team (optional)\"\n                }\n            }\n        }\n    }\n}",
