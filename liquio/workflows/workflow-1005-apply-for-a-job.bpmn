{
 "workflowTemplate": {
  "id": 1005,
  "workflowTemplateCategoryId": null,
  "name": "Apply for a job",
  "description": "iGrant.io journey step 3: apply at CivicWorks Careers with the credentials in your wallet — one scan shares your PID and educational certificate, and the application form fills itself.",
  "xmlBpmnSchema": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn2:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:bpmn2=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"apply-for-a-job-diagram\" targetNamespace=\"http://bpmn.io/schema/bpmn\" xsi:schemaLocation=\"http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd\">\n  <bpmn2:collaboration id=\"Collaboration_apply-for-a-job-diagram\">\n    <bpmn2:participant id=\"Participant_apply-for-a-job-diagram\" name=\"Apply for a job\" processRef=\"Process_1\" />\n  </bpmn2:collaboration>\n  <bpmn2:process id=\"Process_1\" isExecutable=\"false\">\n    <bpmn2:laneSet id=\"LaneSet_apply-for-a-job-diagram\">\n      <bpmn2:lane id=\"Lane_apply-for-a-job-diagram\" name=\"Candidate\">\n        <bpmn2:flowNodeRef>StartEvent_1</bpmn2:flowNodeRef>\n        <bpmn2:flowNodeRef>task-1005001</bpmn2:flowNodeRef>\n        <bpmn2:flowNodeRef>task-1005002</bpmn2:flowNodeRef>\n        <bpmn2:flowNodeRef>event-1005001</bpmn2:flowNodeRef>\n        <bpmn2:flowNodeRef>task-1005003</bpmn2:flowNodeRef>\n        <bpmn2:flowNodeRef>gateway-1005001</bpmn2:flowNodeRef>\n        <bpmn2:flowNodeRef>task-1005005</bpmn2:flowNodeRef>\n        <bpmn2:flowNodeRef>end-event-1</bpmn2:flowNodeRef>\n        <bpmn2:flowNodeRef>task-1005004</bpmn2:flowNodeRef>\n        <bpmn2:flowNodeRef>end-event-2</bpmn2:flowNodeRef>\n      </bpmn2:lane>\n    </bpmn2:laneSet>\n    <bpmn2:startEvent id=\"StartEvent_1\">\n      <bpmn2:outgoing>Flow_01</bpmn2:outgoing>\n    </bpmn2:startEvent>\n    <bpmn2:task id=\"task-1005001\" name=\"Start\">\n      <bpmn2:incoming>Flow_01</bpmn2:incoming>\n      <bpmn2:outgoing>Flow_02</bpmn2:outgoing>\n    </bpmn2:task>\n    <bpmn2:task id=\"task-1005002\" name=\"Choose a role\">\n      <bpmn2:incoming>Flow_02</bpmn2:incoming>\n      <bpmn2:outgoing>Flow_03</bpmn2:outgoing>\n    </bpmn2:task>\n    <bpmn2:intermediateCatchEvent id=\"event-1005001\" name=\"Request credentials (verify)\">\n      <bpmn2:incoming>Flow_03</bpmn2:incoming>\n      <bpmn2:outgoing>Flow_04</bpmn2:outgoing>\n      <bpmn2:conditionalEventDefinition id=\"Cond_event-1005001\">\n        <bpmn2:condition xsi:type=\"bpmn2:tFormalExpression\" />\n      </bpmn2:conditionalEventDefinition>\n    </bpmn2:intermediateCatchEvent>\n    <bpmn2:task id=\"task-1005003\" name=\"Share your credentials\">\n      <bpmn2:incoming>Flow_04</bpmn2:incoming>\n      <bpmn2:outgoing>Flow_05</bpmn2:outgoing>\n    </bpmn2:task>\n    <bpmn2:exclusiveGateway id=\"gateway-1005001\" name=\"Credentials verified?\">\n      <bpmn2:incoming>Flow_05</bpmn2:incoming>\n      <bpmn2:outgoing>Flow_06</bpmn2:outgoing>\n      <bpmn2:outgoing>Flow_08</bpmn2:outgoing>\n    </bpmn2:exclusiveGateway>\n    <bpmn2:task id=\"task-1005005\" name=\"Review and submit\">\n      <bpmn2:incoming>Flow_06</bpmn2:incoming>\n      <bpmn2:outgoing>Flow_07</bpmn2:outgoing>\n    </bpmn2:task>\n    <bpmn2:endEvent id=\"end-event-1\">\n      <bpmn2:incoming>Flow_07</bpmn2:incoming>\n    </bpmn2:endEvent>\n    <bpmn2:task id=\"task-1005004\" name=\"Application failed\">\n      <bpmn2:incoming>Flow_08</bpmn2:incoming>\n      <bpmn2:outgoing>Flow_09</bpmn2:outgoing>\n    </bpmn2:task>\n    <bpmn2:endEvent id=\"end-event-2\">\n      <bpmn2:incoming>Flow_09</bpmn2:incoming>\n    </bpmn2:endEvent>\n    <bpmn2:sequenceFlow id=\"Flow_01\" sourceRef=\"StartEvent_1\" targetRef=\"task-1005001\" />\n    <bpmn2:sequenceFlow id=\"Flow_02\" sourceRef=\"task-1005001\" targetRef=\"task-1005002\" />\n    <bpmn2:sequenceFlow id=\"Flow_03\" sourceRef=\"task-1005002\" targetRef=\"event-1005001\" />\n    <bpmn2:sequenceFlow id=\"Flow_04\" sourceRef=\"event-1005001\" targetRef=\"task-1005003\" />\n    <bpmn2:sequenceFlow id=\"Flow_05\" sourceRef=\"task-1005003\" targetRef=\"gateway-1005001\" />\n    <bpmn2:sequenceFlow id=\"Flow_06\" name=\"Yes\" sourceRef=\"gateway-1005001\" targetRef=\"task-1005005\" />\n    <bpmn2:sequenceFlow id=\"Flow_07\" sourceRef=\"task-1005005\" targetRef=\"end-event-1\" />\n    <bpmn2:sequenceFlow id=\"Flow_08\" name=\"No\" sourceRef=\"gateway-1005001\" targetRef=\"task-1005004\" />\n    <bpmn2:sequenceFlow id=\"Flow_09\" sourceRef=\"task-1005004\" targetRef=\"end-event-2\" />\n  </bpmn2:process>\n  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration_apply-for-a-job-diagram\">\n      <bpmndi:BPMNShape id=\"Participant_apply-for-a-job-diagram_di\" bpmnElement=\"Participant_apply-for-a-job-diagram\" isHorizontal=\"true\">\n        <dc:Bounds x=\"120\" y=\"80\" width=\"1176\" height=\"420\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"Lane_apply-for-a-job-diagram_di\" bpmnElement=\"Lane_apply-for-a-job-diagram\" isHorizontal=\"true\">\n        <dc:Bounds x=\"150\" y=\"80\" width=\"1146\" height=\"420\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n        <dc:Bounds x=\"172\" y=\"202\" width=\"36\" height=\"36\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"task-1005001_di\" bpmnElement=\"task-1005001\">\n        <dc:Bounds x=\"260\" y=\"180\" width=\"100\" height=\"80\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"task-1005002_di\" bpmnElement=\"task-1005002\">\n        <dc:Bounds x=\"412\" y=\"180\" width=\"100\" height=\"80\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"event-1005001_di\" bpmnElement=\"event-1005001\">\n        <dc:Bounds x=\"564\" y=\"202\" width=\"36\" height=\"36\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"task-1005003_di\" bpmnElement=\"task-1005003\">\n        <dc:Bounds x=\"652\" y=\"180\" width=\"100\" height=\"80\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"gateway-1005001_di\" bpmnElement=\"gateway-1005001\">\n        <dc:Bounds x=\"804\" y=\"195\" width=\"50\" height=\"50\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"task-1005005_di\" bpmnElement=\"task-1005005\">\n        <dc:Bounds x=\"906\" y=\"180\" width=\"100\" height=\"80\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"end-event-1_di\" bpmnElement=\"end-event-1\">\n        <dc:Bounds x=\"1058\" y=\"202\" width=\"36\" height=\"36\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"task-1005004_di\" bpmnElement=\"task-1005004\">\n        <dc:Bounds x=\"906\" y=\"320\" width=\"100\" height=\"80\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"end-event-2_di\" bpmnElement=\"end-event-2\">\n        <dc:Bounds x=\"1058\" y=\"342\" width=\"36\" height=\"36\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNEdge id=\"Flow_01_di\" bpmnElement=\"Flow_01\">\n        <di:waypoint x=\"208\" y=\"220\" />\n        <di:waypoint x=\"260\" y=\"220\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_02_di\" bpmnElement=\"Flow_02\">\n        <di:waypoint x=\"360\" y=\"220\" />\n        <di:waypoint x=\"412\" y=\"220\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_03_di\" bpmnElement=\"Flow_03\">\n        <di:waypoint x=\"512\" y=\"220\" />\n        <di:waypoint x=\"564\" y=\"220\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_04_di\" bpmnElement=\"Flow_04\">\n        <di:waypoint x=\"600\" y=\"220\" />\n        <di:waypoint x=\"652\" y=\"220\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_05_di\" bpmnElement=\"Flow_05\">\n        <di:waypoint x=\"752\" y=\"220\" />\n        <di:waypoint x=\"804\" y=\"220\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_06_di\" bpmnElement=\"Flow_06\">\n        <di:waypoint x=\"854\" y=\"220\" />\n        <di:waypoint x=\"906\" y=\"220\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_07_di\" bpmnElement=\"Flow_07\">\n        <di:waypoint x=\"1006\" y=\"220\" />\n        <di:waypoint x=\"1058\" y=\"220\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_08_di\" bpmnElement=\"Flow_08\">\n        <di:waypoint x=\"829\" y=\"245\" />\n        <di:waypoint x=\"829\" y=\"360\" />\n        <di:waypoint x=\"906\" y=\"360\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_09_di\" bpmnElement=\"Flow_09\">\n        <di:waypoint x=\"1006\" y=\"360\" />\n        <di:waypoint x=\"1058\" y=\"360\" />\n      </bpmndi:BPMNEdge>\n    </bpmndi:BPMNPlane>\n  </bpmndi:BPMNDiagram>\n</bpmn2:definitions>\n",
