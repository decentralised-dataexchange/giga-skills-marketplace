  {
   "id": 1005003,
   "name": "Share your credentials",
   "jsonSchema": {
    "title": "Share your credentials",
    "type": "object",
    "pdfRequired": false,
    "signRequired": false,
    "showNextTaskButton": false,
    "finishBtn": "Continue",
    "forceRedirect": true,
    "properties": {
     "share": {
      "type": "object",
      "properties": {
       "wallet": {
        "type": "object",
        "control": "igrant.credential",
        "mode": "verify",
        "checkService": "igrant",
        "title": "Apply with your wallet",
        "pendingText": "Scan with your wallet and share your PID and your educational certificate — the PID fills your details; the certificate is your evidence.",
        "successText": "Credentials received — your application is verified.",
        "settingsName": "REPLACE_WITH_EMPLOYER_SETTINGS_NAME",
        "value": "({documents, events, documentData, user}) => { const rows = (events || []).filter((e) => e.eventTemplateId === 1005001).sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt)); const r = rows[0]?.data?.result?.sendToExternalService?.sendingResult?.response || {}; return { uri: r.qrUri || '', exchangeId: r.exchangeId || '' }; }"
       }
      }
     }
    }
   },
   "jsonSchemaRaw": "{\n    \"title\": \"Share your credentials\",\n    \"type\": \"object\",\n    \"pdfRequired\": false,\n    \"signRequired\": false,\n    \"showNextTaskButton\": false,\n    \"finishBtn\": \"Continue\",\n    \"forceRedirect\": true,\n    \"properties\": {\n        \"share\": {\n            \"type\": \"object\",\n            \"properties\": {\n                \"wallet\": {\n                    \"type\": \"object\",\n                    \"control\": \"igrant.credential\",\n                    \"mode\": \"verify\",\n                    \"checkService\": \"igrant\",\n                    \"title\": \"Apply with your wallet\",\n                    \"pendingText\": \"Scan with your wallet and share your PID and your educational certificate \\u2014 the PID fills your details; the certificate is your evidence.\",\n                    \"successText\": \"Credentials received \\u2014 your application is verified.\",\n                    \"settingsName\": \"REPLACE_WITH_EMPLOYER_SETTINGS_NAME\",\n                    \"value\": \"({documents, events, documentData, user}) => { const rows = (events || []).filter((e) => e.eventTemplateId === 1005001).sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt)); const r = rows[0]?.data?.result?.sendToExternalService?.sendingResult?.response || {}; return { uri: r.qrUri || '', exchangeId: r.exchangeId || '' }; }\"\n                }\n            }\n        }\n    }\n}",
