 "eventTemplates": [
  {
   "id": 1003001,
   "eventTypeId": 3,
   "name": "Issue certificate credential",
   "description": "",
   "jsonSchema": {
    "sendToExternalService": {
     "providerName": "igrant",
     "service": "igrant",
     "options": {
      "operation": "() => 'issue'",
      "settingsName": "() => 'REPLACE_WITH_SETTINGS_NAME'",
      "credentialDefinitionId": "() => 'REPLACE_WITH_EDU_CERT_DEFINITION_ID'",
      "issuanceMode": "() => 'InTime'",
      "claims": "(document, event, documents, events) => { const sel = (documents || []).find((x) => x.documentTemplateId === 1003002) || {}; const prof = (documents || []).find((x) => x.documentTemplateId === 1003005) || {}; const claims = ((((prof.data || {}).share || {}).wallet || {}).result || {}).claims || {}; const prog = String(claims.programme_name || ''); const level = /^(MSc|MA|M\\.|Master)/i.test(prog) ? 'Master' : 'Bachelor'; return { given_name: claims.given_name || '', family_name: claims.family_name || '', birthdate: claims.birthdate || '', id_number: claims.id_number || '', phone: claims.phone || '', email: claims.email || '', institution: claims.institution || '', programme_name: prog, programme_level: level, final_outcome: 'Passed', ulid: String(claims.ulid || sel.id || ''), issue_date: new Date().toISOString().slice(0, 10) }; }",
      "presentationDefinitionId": "(document, event, documents, events) => { const doc = (documents || []).find((x) => x.documentTemplateId === 1003002) || {}; const m = ((doc.data || {}).payment || {}).method; return m === 'card' ? 'REPLACE_WITH_CARD_PAYMENT_PRESENTATION_DEFINITION_ID' : 'REPLACE_WITH_ACCOUNT_PAYMENT_PRESENTATION_DEFINITION_ID'; }",
      "transactionData": "(document, event, documents, events) => { const doc = (documents || []).find((x) => x.documentTemplateId === 1003002) || {}; return { payload: { transaction_id: String(doc.id || 'txn').slice(0, 36), date_time: new Date().toISOString(), payee: { name: 'Ministry of Education', id: 'ESR-MOE-0001', website: 'https://education-showcase.eubw.dev' }, execution_date: new Date().toISOString().slice(0, 10), currency: 'EUR', amount: 10 } }; }"
     }
    }
   },
   "jsonSchemaRaw": "{\n    \"sendToExternalService\": {\n        \"providerName\": \"igrant\",\n        \"service\": \"igrant\",\n        \"options\": {\n            \"operation\": \"() => 'issue'\",\n            \"settingsName\": \"() => 'REPLACE_WITH_SETTINGS_NAME'\",\n            \"credentialDefinitionId\": \"() => 'REPLACE_WITH_EDU_CERT_DEFINITION_ID'\",\n            \"issuanceMode\": \"() => 'InTime'\",\n            \"claims\": \"(document, event, documents, events) => { const sel = (documents || []).find((x) => x.documentTemplateId === 1003002) || {}; const prof = (documents || []).find((x) => x.documentTemplateId === 1003005) || {}; const claims = ((((prof.data || {}).share || {}).wallet || {}).result || {}).claims || {}; const prog = String(claims.programme_name || ''); const level = /^(MSc|MA|M\\\\.|Master)/i.test(prog) ? 'Master' : 'Bachelor'; return { given_name: claims.given_name || '', family_name: claims.family_name || '', birthdate: claims.birthdate || '', id_number: claims.id_number || '', phone: claims.phone || '', email: claims.email || '', institution: claims.institution || '', programme_name: prog, programme_level: level, final_outcome: 'Passed', ulid: String(claims.ulid || sel.id || ''), issue_date: new Date().toISOString().slice(0, 10) }; }\",\n            \"presentationDefinitionId\": \"(document, event, documents, events) => { const doc = (documents || []).find((x) => x.documentTemplateId === 1003002) || {}; const m = ((doc.data || {}).payment || {}).method; return m === 'card' ? 'REPLACE_WITH_CARD_PAYMENT_PRESENTATION_DEFINITION_ID' : 'REPLACE_WITH_ACCOUNT_PAYMENT_PRESENTATION_DEFINITION_ID'; }\",\n            \"transactionData\": \"(document, event, documents, events) => { const doc = (documents || []).find((x) => x.documentTemplateId === 1003002) || {}; return { payload: { transaction_id: String(doc.id || 'txn').slice(0, 36), date_time: new Date().toISOString(), payee: { name: 'Ministry of Education', id: 'ESR-MOE-0001', website: 'https://education-showcase.eubw.dev' }, execution_date: new Date().toISOString().slice(0, 10), currency: 'EUR', amount: 10 } }; }\"\n        }\n    }\n}",
   "htmlTemplate": "",
   "createdAt": "2026-08-26T09:00:00.000Z",
   "updatedAt": "2026-08-26T09:00:00.000Z"
  },
