 "documentTemplates": [
  {
   "id": 1004001,
   "name": "Start",
   "jsonSchema": {
    "title": "Register as a learner",
    "type": "object",
    "pdfRequired": false,
    "signRequired": false,
    "showNextTaskButton": false,
    "finishBtn": "Continue",
    "forceRedirect": true,
    "properties": {
     "intro": {
      "type": "object",
      "description": "Welcome",
      "properties": {
       "text": {
        "control": "text.block",
        "htmlBlock": "<div><p>This service registers you as a learner: you share your identity from your wallet, choose your institution and programme, and receive a <b>Learner Profile</b> credential with your unique learner identifier (ULID).</p><p style='margin-bottom:4px;'><b>Your journey:</b></p><ul style='margin:6px 0;padding-left:0;list-style:none;'><li style='margin:5px 0;'><b>1. Register as a learner</b> — share your ID, enrol, and receive your Learner Profile credential <span style='color:#0e7c7b;font-weight:600;'>← you are here</span></li><li style='margin:5px 0;'>2. <a href='/tasks/create/1003/1003001' style='color:#1a56db;text-decoration:underline;'>Educational certificate</a> — pay the 10.00 EUR fee from your wallet and receive your certificate</li><li style='margin:5px 0;'>3. <a href='/tasks/create/1005/1005001' style='color:#1a56db;text-decoration:underline;'>Apply for a job</a> — share your ID and certificate with CivicWorks Careers</li></ul><p style='margin-bottom:4px;'><b>Before you start, you need:</b></p><ul style='margin:6px 0;padding-left:0;list-style:none;'><li style='margin:4px 0;'>1. The <b>iGrant.io Data Wallet</b> app on your phone — <a href='https://docs.igrant.io/docs/data-wallet-tryitout/' style='color:#1a56db;text-decoration:underline;' target='_blank' rel='noopener noreferrer'>download instructions here</a>.</li><li style='margin:4px 0;'>2. A <b>PID credential</b> (person identification data) in the wallet — <a href='https://igrant.io/demo/pid.html' style='color:#1a56db;text-decoration:underline;' target='_blank' rel='noopener noreferrer'>get one here</a>.</li></ul><p>Press Continue to start.</p></div>"
       }
      }
     }
    }
   },
   "jsonSchemaRaw": "{\n    \"title\": \"Register as a learner\",\n    \"type\": \"object\",\n    \"pdfRequired\": false,\n    \"signRequired\": false,\n    \"showNextTaskButton\": false,\n    \"finishBtn\": \"Continue\",\n    \"forceRedirect\": true,\n    \"properties\": {\n        \"intro\": {\n            \"type\": \"object\",\n            \"description\": \"Welcome\",\n            \"properties\": {\n                \"text\": {\n                    \"control\": \"text.block\",\n                    \"htmlBlock\": \"<div><p>This service registers you as a learner: you share your identity from your wallet, choose your institution and programme, and receive a <b>Learner Profile</b> credential with your unique learner identifier (ULID).</p><p style='margin-bottom:4px;'><b>Your journey:</b></p><ul style='margin:6px 0;padding-left:0;list-style:none;'><li style='margin:5px 0;'><b>1. Register as a learner</b> \\u2014 share your ID, enrol, and receive your Learner Profile credential <span style='color:#0e7c7b;font-weight:600;'>\\u2190 you are here</span></li><li style='margin:5px 0;'>2. <a href='/tasks/create/1003/1003001' style='color:#1a56db;text-decoration:underline;'>Educational certificate</a> \\u2014 pay the 10.00 EUR fee from your wallet and receive your certificate</li><li style='margin:5px 0;'>3. <a href='/tasks/create/1005/1005001' style='color:#1a56db;text-decoration:underline;'>Apply for a job</a> \\u2014 share your ID and certificate with CivicWorks Careers</li></ul><p style='margin-bottom:4px;'><b>Before you start, you need:</b></p><ul style='margin:6px 0;padding-left:0;list-style:none;'><li style='margin:4px 0;'>1. The <b>iGrant.io Data Wallet</b> app on your phone \\u2014 <a href='https://docs.igrant.io/docs/data-wallet-tryitout/' style='color:#1a56db;text-decoration:underline;' target='_blank' rel='noopener noreferrer'>download instructions here</a>.</li><li style='margin:4px 0;'>2. A <b>PID credential</b> (person identification data) in the wallet \\u2014 <a href='https://igrant.io/demo/pid.html' style='color:#1a56db;text-decoration:underline;' target='_blank' rel='noopener noreferrer'>get one here</a>.</li></ul><p>Press Continue to start.</p></div>\"\n                }\n            }\n        }\n    }\n}",
   "htmlTemplate": "",
   "accessJsonSchema": {},
   "additionalDataToSign": null,
   "createdAt": "2026-08-26T09:00:00.000Z",
   "updatedAt": "2026-08-26T09:00:00.000Z"
  },
  {
   "id": 1004002,
   "name": "Share your ID",
   "jsonSchema": {
    "title": "Share your ID",
    "type": "object",
    "pdfRequired": false,
    "signRequired": false,
    "showNextTaskButton": false,
    "finishBtn": "Continue",
    "forceRedirect": true,
    "properties": {
     "share": {
      "type": "object",
      "properties": {
       "wallet": {
        "type": "object",
        "control": "igrant.credential",
        "mode": "verify",
        "checkService": "igrant",
        "title": "Scan with your wallet",
        "pendingText": "Share your PID (person identification data) from your wallet — it fills the enrolment form for you.",
        "successText": "Identity received. Thank you!",
        "settingsName": "REPLACE_WITH_SETTINGS_NAME",
        "value": "({documents, events, documentData, user}) => { const rows = (events || []).filter((e) => e.eventTemplateId === 1004001).sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt)); const r = rows[0]?.data?.result?.sendToExternalService?.sendingResult?.response || {}; return { uri: r.qrUri || '', exchangeId: r.exchangeId || '' }; }"
       }
      }
     }
    }
   },
   "jsonSchemaRaw": "{\n    \"title\": \"Share your ID\",\n    \"type\": \"object\",\n    \"pdfRequired\": false,\n    \"signRequired\": false,\n    \"showNextTaskButton\": false,\n    \"finishBtn\": \"Continue\",\n    \"forceRedirect\": true,\n    \"properties\": {\n        \"share\": {\n            \"type\": \"object\",\n            \"properties\": {\n                \"wallet\": {\n                    \"type\": \"object\",\n                    \"control\": \"igrant.credential\",\n                    \"mode\": \"verify\",\n                    \"checkService\": \"igrant\",\n                    \"title\": \"Scan with your wallet\",\n                    \"pendingText\": \"Share your PID (person identification data) from your wallet \\u2014 it fills the enrolment form for you.\",\n                    \"successText\": \"Identity received. Thank you!\",\n                    \"settingsName\": \"REPLACE_WITH_SETTINGS_NAME\",\n                    \"value\": \"({documents, events, documentData, user}) => { const rows = (events || []).filter((e) => e.eventTemplateId === 1004001).sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt)); const r = rows[0]?.data?.result?.sendToExternalService?.sendingResult?.response || {}; return { uri: r.qrUri || '', exchangeId: r.exchangeId || '' }; }\"\n                }\n            }\n        }\n    }\n}",
   "htmlTemplate": "",
   "accessJsonSchema": {},
   "additionalDataToSign": null,
