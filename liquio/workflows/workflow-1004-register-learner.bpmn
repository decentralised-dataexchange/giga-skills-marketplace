   "jsonSchema": {
    "title": "Enrol",
    "type": "object",
    "pdfRequired": false,
    "signRequired": false,
    "showNextTaskButton": false,
    "finishBtn": "Enrol",
    "forceRedirect": true,
    "properties": {
     "personal": {
      "type": "object",
      "description": "Your details (from your ID)",
      "properties": {
       "firstName": {
        "type": "string",
        "description": "First name",
        "value": "({documents, events, documentData, user}) => { const d = (documents || []).find((x) => x.documentTemplateId === 1004002); const c = d?.data?.share?.wallet?.result?.claims || {}; return c.given_name || ''; }",
        "readOnly": true,
        "checkRequired": "() => true"
       },
       "lastName": {
        "type": "string",
        "description": "Last name",
        "value": "({documents, events, documentData, user}) => { const d = (documents || []).find((x) => x.documentTemplateId === 1004002); const c = d?.data?.share?.wallet?.result?.claims || {}; return c.family_name || ''; }",
        "readOnly": true,
        "checkRequired": "() => true"
       },
       "dateOfBirth": {
        "type": "string",
        "description": "Date of birth",
        "value": "({documents, events, documentData, user}) => { const d = (documents || []).find((x) => x.documentTemplateId === 1004002); const c = d?.data?.share?.wallet?.result?.claims || {}; return c.birthdate || ''; }",
        "readOnly": true
       },
       "email": {
        "type": "string",
        "description": "Email",
        "value": "({documents, events, documentData, user}) => { const d = (documents || []).find((x) => x.documentTemplateId === 1004002); const c = d?.data?.share?.wallet?.result?.claims || {}; return c.email || ''; }",
        "readOnly": true
       },
       "idNumber": {
        "type": "string",
        "description": "National ID number",
        "checkRequired": "() => true",
        "value": "({documents, events, documentData, user}) => { const d = (documents || []).find((x) => x.documentTemplateId === 1004002); const c = d?.data?.share?.wallet?.result?.claims || {}; if (c.personal_administrative_number) { return String(c.personal_administrative_number); } const b = String(c.birthdate || '').replace(/[^0-9]/g, '').slice(2, 8) || '970101'; const name = String(c.given_name || '') + String(c.family_name || ''); let h = 0; for (let i = 0; i < name.length; i += 1) { h = (h * 31 + name.charCodeAt(i)) % 10000; } return b + '-' + String(h).padStart(4, '0'); }"
       },
       "phone": {
        "type": "string",
        "description": "Phone"
       }
      }
     },
     "enrolment": {
      "type": "object",
      "description": "Enrolment",
      "properties": {
       "institution": {
        "type": "string",
        "description": "Educational institution",
        "control": "radio.group",
        "checkRequired": "() => true",
        "items": [
         {
          "id": "Kyiv Polytechnic Institute",
          "title": "Kyiv Polytechnic Institute"
         },
         {
          "id": "Taras Shevchenko National University",
          "title": "Taras Shevchenko National University"
         }
        ]
       },
       "programmeName": {
        "type": "string",
        "description": "Programme",
        "control": "radio.group",
        "checkRequired": "() => true",
        "items": [
         {
          "id": "BSc Computer Science",
          "title": "BSc Computer Science"
         },
         {
          "id": "MSc Data Engineering",
          "title": "MSc Data Engineering"
         },
         {
          "id": "BA Public Administration",
          "title": "BA Public Administration"
         }
        ]
       }
      }
     }
    }
   },
