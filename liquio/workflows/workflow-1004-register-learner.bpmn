{
 "workflowTemplate": {
  "id": 1004,
  "workflowTemplateCategoryId": null,
  "name": "Register as a learner",
  "description": "iGrant.io journey step 1: share your PID from the wallet, enrol into an institution, and receive a Learner Profile credential with your unique learner identifier.",
  "xmlBpmnSchema": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn2:definitions xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:bpmn2=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"register-learner-diagram\" targetNamespace=\"http://bpmn.io/schema/bpmn\" xsi:schemaLocation=\"http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd\">\n  <bpmn2:collaboration id=\"Collaboration_register-learner-diagram\">\n    <bpmn2:participant id=\"Participant_register-learner-diagram\" name=\"Register as a learner\" processRef=\"Process_1\" />\n  </bpmn2:collaboration>\n  <bpmn2:process id=\"Process_1\" isExecutable=\"false\">\n    <bpmn2:laneSet id=\"LaneSet_register-learner-diagram\">\n      <bpmn2:lane id=\"Lane_register-learner-diagram\" name=\"Learner\">\n        <bpmn2:flowNodeRef>StartEvent_1</bpmn2:flowNodeRef>\n        <bpmn2:flowNodeRef>task-1004001</bpmn2:flowNodeRef>\n        <bpmn2:flowNodeRef>event-1004001</bpmn2:flowNodeRef>\n        <bpmn2:flowNodeRef>task-1004002</bpmn2:flowNodeRef>\n        <bpmn2:flowNodeRef>gateway-1004001</bpmn2:flowNodeRef>\n        <bpmn2:flowNodeRef>task-1004004</bpmn2:flowNodeRef>\n        <bpmn2:flowNodeRef>event-1004002</bpmn2:flowNodeRef>\n        <bpmn2:flowNodeRef>task-1004005</bpmn2:flowNodeRef>\n        <bpmn2:flowNodeRef>end-event-1</bpmn2:flowNodeRef>\n        <bpmn2:flowNodeRef>task-1004003</bpmn2:flowNodeRef>\n        <bpmn2:flowNodeRef>end-event-2</bpmn2:flowNodeRef>\n      </bpmn2:lane>\n    </bpmn2:laneSet>\n    <bpmn2:startEvent id=\"StartEvent_1\">\n      <bpmn2:outgoing>Flow_01</bpmn2:outgoing>\n    </bpmn2:startEvent>\n    <bpmn2:task id=\"task-1004001\" name=\"Start\">\n      <bpmn2:incoming>Flow_01</bpmn2:incoming>\n      <bpmn2:outgoing>Flow_02</bpmn2:outgoing>\n    </bpmn2:task>\n    <bpmn2:intermediateCatchEvent id=\"event-1004001\" name=\"Verify your ID (PID)\">\n      <bpmn2:incoming>Flow_02</bpmn2:incoming>\n      <bpmn2:outgoing>Flow_03</bpmn2:outgoing>\n      <bpmn2:conditionalEventDefinition id=\"Cond_event-1004001\">\n        <bpmn2:condition xsi:type=\"bpmn2:tFormalExpression\" />\n      </bpmn2:conditionalEventDefinition>\n    </bpmn2:intermediateCatchEvent>\n    <bpmn2:task id=\"task-1004002\" name=\"Share your ID\">\n      <bpmn2:incoming>Flow_03</bpmn2:incoming>\n      <bpmn2:outgoing>Flow_04</bpmn2:outgoing>\n    </bpmn2:task>\n    <bpmn2:exclusiveGateway id=\"gateway-1004001\" name=\"ID verified?\">\n      <bpmn2:incoming>Flow_04</bpmn2:incoming>\n      <bpmn2:outgoing>Flow_05</bpmn2:outgoing>\n      <bpmn2:outgoing>Flow_09</bpmn2:outgoing>\n    </bpmn2:exclusiveGateway>\n    <bpmn2:task id=\"task-1004004\" name=\"Enrol\">\n      <bpmn2:incoming>Flow_05</bpmn2:incoming>\n      <bpmn2:outgoing>Flow_06</bpmn2:outgoing>\n    </bpmn2:task>\n    <bpmn2:intermediateCatchEvent id=\"event-1004002\" name=\"Issue Learner Profile\">\n      <bpmn2:incoming>Flow_06</bpmn2:incoming>\n      <bpmn2:outgoing>Flow_07</bpmn2:outgoing>\n      <bpmn2:conditionalEventDefinition id=\"Cond_event-1004002\">\n        <bpmn2:condition xsi:type=\"bpmn2:tFormalExpression\" />\n      </bpmn2:conditionalEventDefinition>\n    </bpmn2:intermediateCatchEvent>\n    <bpmn2:task id=\"task-1004005\" name=\"Save your Learner Profile\">\n      <bpmn2:incoming>Flow_07</bpmn2:incoming>\n      <bpmn2:outgoing>Flow_08</bpmn2:outgoing>\n    </bpmn2:task>\n    <bpmn2:endEvent id=\"end-event-1\">\n      <bpmn2:incoming>Flow_08</bpmn2:incoming>\n    </bpmn2:endEvent>\n    <bpmn2:task id=\"task-1004003\" name=\"Verification failed\">\n      <bpmn2:incoming>Flow_09</bpmn2:incoming>\n      <bpmn2:outgoing>Flow_10</bpmn2:outgoing>\n    </bpmn2:task>\n    <bpmn2:endEvent id=\"end-event-2\">\n      <bpmn2:incoming>Flow_10</bpmn2:incoming>\n    </bpmn2:endEvent>\n    <bpmn2:sequenceFlow id=\"Flow_01\" sourceRef=\"StartEvent_1\" targetRef=\"task-1004001\" />\n    <bpmn2:sequenceFlow id=\"Flow_02\" sourceRef=\"task-1004001\" targetRef=\"event-1004001\" />\n    <bpmn2:sequenceFlow id=\"Flow_03\" sourceRef=\"event-1004001\" targetRef=\"task-1004002\" />\n    <bpmn2:sequenceFlow id=\"Flow_04\" sourceRef=\"task-1004002\" targetRef=\"gateway-1004001\" />\n    <bpmn2:sequenceFlow id=\"Flow_05\" name=\"Yes\" sourceRef=\"gateway-1004001\" targetRef=\"task-1004004\" />\n    <bpmn2:sequenceFlow id=\"Flow_06\" sourceRef=\"task-1004004\" targetRef=\"event-1004002\" />\n    <bpmn2:sequenceFlow id=\"Flow_07\" sourceRef=\"event-1004002\" targetRef=\"task-1004005\" />\n    <bpmn2:sequenceFlow id=\"Flow_08\" sourceRef=\"task-1004005\" targetRef=\"end-event-1\" />\n    <bpmn2:sequenceFlow id=\"Flow_09\" name=\"No\" sourceRef=\"gateway-1004001\" targetRef=\"task-1004003\" />\n    <bpmn2:sequenceFlow id=\"Flow_10\" sourceRef=\"task-1004003\" targetRef=\"end-event-2\" />\n  </bpmn2:process>\n  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration_register-learner-diagram\">\n      <bpmndi:BPMNShape id=\"Participant_register-learner-diagram_di\" bpmnElement=\"Participant_register-learner-diagram\" isHorizontal=\"true\">\n        <dc:Bounds x=\"120\" y=\"80\" width=\"1264\" height=\"420\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"Lane_register-learner-diagram_di\" bpmnElement=\"Lane_register-learner-diagram\" isHorizontal=\"true\">\n        <dc:Bounds x=\"150\" y=\"80\" width=\"1234\" height=\"420\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"StartEvent_1_di\" bpmnElement=\"StartEvent_1\">\n        <dc:Bounds x=\"172\" y=\"202\" width=\"36\" height=\"36\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"task-1004001_di\" bpmnElement=\"task-1004001\">\n        <dc:Bounds x=\"260\" y=\"180\" width=\"100\" height=\"80\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"event-1004001_di\" bpmnElement=\"event-1004001\">\n        <dc:Bounds x=\"412\" y=\"202\" width=\"36\" height=\"36\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"task-1004002_di\" bpmnElement=\"task-1004002\">\n        <dc:Bounds x=\"500\" y=\"180\" width=\"100\" height=\"80\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"gateway-1004001_di\" bpmnElement=\"gateway-1004001\">\n        <dc:Bounds x=\"652\" y=\"195\" width=\"50\" height=\"50\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"task-1004004_di\" bpmnElement=\"task-1004004\">\n        <dc:Bounds x=\"754\" y=\"180\" width=\"100\" height=\"80\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"event-1004002_di\" bpmnElement=\"event-1004002\">\n        <dc:Bounds x=\"906\" y=\"202\" width=\"36\" height=\"36\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"task-1004005_di\" bpmnElement=\"task-1004005\">\n        <dc:Bounds x=\"994\" y=\"180\" width=\"100\" height=\"80\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"end-event-1_di\" bpmnElement=\"end-event-1\">\n        <dc:Bounds x=\"1146\" y=\"202\" width=\"36\" height=\"36\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"task-1004003_di\" bpmnElement=\"task-1004003\">\n        <dc:Bounds x=\"754\" y=\"320\" width=\"100\" height=\"80\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"end-event-2_di\" bpmnElement=\"end-event-2\">\n        <dc:Bounds x=\"906\" y=\"342\" width=\"36\" height=\"36\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNEdge id=\"Flow_01_di\" bpmnElement=\"Flow_01\">\n        <di:waypoint x=\"208\" y=\"220\" />\n        <di:waypoint x=\"260\" y=\"220\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_02_di\" bpmnElement=\"Flow_02\">\n        <di:waypoint x=\"360\" y=\"220\" />\n        <di:waypoint x=\"412\" y=\"220\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_03_di\" bpmnElement=\"Flow_03\">\n        <di:waypoint x=\"448\" y=\"220\" />\n        <di:waypoint x=\"500\" y=\"220\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_04_di\" bpmnElement=\"Flow_04\">\n        <di:waypoint x=\"600\" y=\"220\" />\n        <di:waypoint x=\"652\" y=\"220\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_05_di\" bpmnElement=\"Flow_05\">\n        <di:waypoint x=\"702\" y=\"220\" />\n        <di:waypoint x=\"754\" y=\"220\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_06_di\" bpmnElement=\"Flow_06\">\n        <di:waypoint x=\"854\" y=\"220\" />\n        <di:waypoint x=\"906\" y=\"220\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_07_di\" bpmnElement=\"Flow_07\">\n        <di:waypoint x=\"942\" y=\"220\" />\n        <di:waypoint x=\"994\" y=\"220\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_08_di\" bpmnElement=\"Flow_08\">\n        <di:waypoint x=\"1094\" y=\"220\" />\n        <di:waypoint x=\"1146\" y=\"220\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_09_di\" bpmnElement=\"Flow_09\">\n        <di:waypoint x=\"677\" y=\"245\" />\n        <di:waypoint x=\"677\" y=\"360\" />\n        <di:waypoint x=\"754\" y=\"360\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_10_di\" bpmnElement=\"Flow_10\">\n        <di:waypoint x=\"854\" y=\"360\" />\n        <di:waypoint x=\"906\" y=\"360\" />\n      </bpmndi:BPMNEdge>\n    </bpmndi:BPMNPlane>\n  </bpmndi:BPMNDiagram>\n</bpmn2:definitions>\n",
