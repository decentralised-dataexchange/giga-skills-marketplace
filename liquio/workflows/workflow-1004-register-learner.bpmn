 "gatewayTemplates": [
  {
   "id": 1004001,
   "gatewayTypeId": 1,
   "name": "ID verified?",
   "description": "",
   "jsonSchema": {
    "formulas": [
     {
      "isDefault": false,
      "id": "Yes",
      "condition": "(documents, events) => { const d = documents.find((x) => x.documentTemplateId === 1004002); return d?.data?.share?.wallet?.result?.verified === true; };"
     },
     {
      "isDefault": false,
      "id": "No",
      "condition": "(documents, events) => { const d = documents.find((x) => x.documentTemplateId === 1004002); return d?.data?.share?.wallet?.result?.verified !== true; };"
     }
    ],
    "isCurrentOnly": true
   },
   "jsonSchemaRaw": "{\n    \"formulas\": [\n        {\n            \"isDefault\": false,\n            \"id\": \"Yes\",\n            \"condition\": \"(documents, events) => { const d = documents.find((x) => x.documentTemplateId === 1004002); return d?.data?.share?.wallet?.result?.verified === true; };\"\n        },\n        {\n            \"isDefault\": false,\n            \"id\": \"No\",\n            \"condition\": \"(documents, events) => { const d = documents.find((x) => x.documentTemplateId === 1004002); return d?.data?.share?.wallet?.result?.verified !== true; };\"\n        }\n    ],\n    \"isCurrentOnly\": true\n}",
