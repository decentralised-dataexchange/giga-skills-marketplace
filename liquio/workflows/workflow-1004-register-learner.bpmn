  {
   "id": 1004003,
   "name": "Verification failed",
   "jsonSchema": {
    "title": "Verification failed",
    "type": "object",
    "pdfRequired": false,
    "signRequired": false,
    "showNextTaskButton": false,
    "finishBtn": "Close",
    "finalScreen": {
     "title": "Verification failed",
     "subtitle": "Your identity could not be verified."
    },
    "properties": {
     "failed": {
      "type": "object",
      "properties": {
       "text": {
        "control": "text.block",
        "htmlBlock": "<div><p>Your identity could not be verified. You need a <b>PID credential</b> in your wallet — <a href='https://igrant.io/demo/pid.html' style='color:#1a56db;text-decoration:underline;' target='_blank' rel='noopener noreferrer'>get one here</a> and order this service again.</p></div>"
       }
      }
     }
    }
   },
   "jsonSchemaRaw": "{\n    \"title\": \"Verification failed\",\n    \"type\": \"object\",\n    \"pdfRequired\": false,\n    \"signRequired\": false,\n    \"showNextTaskButton\": false,\n    \"finishBtn\": \"Close\",\n    \"finalScreen\": {\n        \"title\": \"Verification failed\",\n        \"subtitle\": \"Your identity could not be verified.\"\n    },\n    \"properties\": {\n        \"failed\": {\n            \"type\": \"object\",\n            \"properties\": {\n                \"text\": {\n                    \"control\": \"text.block\",\n                    \"htmlBlock\": \"<div><p>Your identity could not be verified. You need a <b>PID credential</b> in your wallet \\u2014 <a href='https://igrant.io/demo/pid.html' style='color:#1a56db;text-decoration:underline;' target='_blank' rel='noopener noreferrer'>get one here</a> and order this service again.</p></div>\"\n                }\n            }\n        }\n    }\n}",
