vents, documentData, user}) => { const d = (documents || []).find((x) => x.documentTemplateId === 1004002); const c = d?.data?.share?.wallet?.result?.claims || {}; return c.email || ''; }\",\n                    \"readOnly\": true\n                },\n                \"idNumber\": {\n                    \"type\": \"string\",\n                    \"description\": \"National ID number\",\n                    \"checkRequired\": \"() => true\",\n                    \"value\": \"({documents, events, documentData, user}) => { const d = (documents || []).find((x) => x.documentTemplateId === 1004002); const c = d?.data?.share?.wallet?.result?.claims || {}; if (c.personal_administrative_number) { return String(c.personal_administrative_number); } const b = String(c.birthdate || '').replace(/[^0-9]/g, '').slice(2, 8) || '970101'; const name = String(c.given_name || '') + String(c.family_name || ''); let h = 0; for (let i = 0; i < name.length; i += 1) { h = (h * 31 + name.charCodeAt(i)) % 10000; } return b + '-' + String(h).padStart(4, '0'); }\"\n                },\n                \"phone\": {\n                    \"type\": \"string\",\n                    \"description\": \"Phone\"\n                }\n            }\n        },\n        \"enrolment\": {\n            \"type\": \"object\",\n            \"description\": \"Enrolment\",\n            \"properties\": {\n                \"institution\": {\n                    \"type\": \"string\",\n                    \"description\": \"Educational institution\",\n                    \"control\": \"radio.group\",\n                    \"checkRequired\": \"() => true\",\n                    \"items\": [\n                        {\n                            \"id\": \"Kyiv Polytechnic Institute\",\n                            \"title\": \"Kyiv Polytechnic Institute\"\n                        },\n                        {\n                            \"id\": \"Taras Shevchenko National University\",\n                            \"title\": \"Taras Shevchenko National University\"\n                        }\n                    ]\n                },\n                \"programmeName\": {\n                    \"type\": \"string\",\n                    \"description\": \"Programme\",\n                    \"control\": \"radio.group\",\n                    \"checkRequired\": \"() => true\",\n                    \"items\": [\n                        {\n                            \"id\": \"BSc Computer Science\",\n                            \"title\": \"BSc Computer Science\"\n                        },\n                        {\n                            \"id\": \"MSc Data Engineering\",\n                            \"title\": \"MSc Data Engineering\"\n                        },\n                        {\n                            \"id\": \"BA Public Administration\",\n                            \"title\": \"BA Public Administration\"\n                        }\n                    ]\n                }\n            }\n        }\n    }\n}",
