  {
   "id": 1004005,
   "name": "Save your Learner Profile",
   "jsonSchema": {
    "title": "Save your Learner Profile",
    "type": "object",
    "pdfRequired": false,
    "signRequired": false,
    "showNextTaskButton": false,
    "finishBtn": "Finish",
    "finalScreen": {
     "title": "You are registered!",
     "subtitle": "Your Learner Profile credential is in your wallet. Continue with step 2: Educational certificate."
    },
    "properties": {
     "receive": {
      "type": "object",
      "properties": {
       "wallet": {
        "type": "object",
        "control": "igrant.credential",
        "mode": "issue",
        "checkService": "igrant",
        "title": "Scan to receive your Learner Profile",
        "pendingText": "Scan with your wallet to save your Learner Profile credential — it carries your unique learner identifier (ULID).",
        "successText": "Your Learner Profile is in your wallet!",
        "settingsName": "REPLACE_WITH_SETTINGS_NAME",
        "value": "({documents, events, documentData, user}) => { const rows = (events || []).filter((e) => e.eventTemplateId === 1004002).sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt)); const r = rows[0]?.data?.result?.sendToExternalService?.sendingResult?.response || {}; return { uri: r.offerUri || '', exchangeId: r.exchangeId || '' }; }"
       },
       "nextStep": {
        "control": "text.block",
        "htmlBlock": "<div style='margin-top:12px;'><p><b>Next step:</b> <a href='/tasks/create/1003/1003001' style='color:#1a56db;text-decoration:underline;'>Educational certificate</a> — pay the fee from your wallet and receive your certificate.</p></div>"
       }
      }
     }
    }
   },
   "jsonSchemaRaw": "{\n    \"title\": \"Save your Learner Profile\",\n    \"type\": \"object\",\n    \"pdfRequired\": false,\n    \"signRequired\": false,\n    \"showNextTaskButton\": false,\n    \"finishBtn\": \"Finish\",\n    \"finalScreen\": {\n        \"title\": \"You are registered!\",\n        \"subtitle\": \"Your Learner Profile credential is in your wallet. Continue with step 2: Educational certificate.\"\n    },\n    \"properties\": {\n        \"receive\": {\n            \"type\": \"object\",\n            \"properties\": {\n                \"wallet\": {\n                    \"type\": \"object\",\n                    \"control\": \"igrant.credential\",\n                    \"mode\": \"issue\",\n                    \"checkService\": \"igrant\",\n                    \"title\": \"Scan to receive your Learner Profile\",\n                    \"pendingText\": \"Scan with your wallet to save your Learner Profile credential \\u2014 it carries your unique learner identifier (ULID).\",\n                    \"successText\": \"Your Learner Profile is in your wallet!\",\n                    \"settingsName\": \"REPLACE_WITH_SETTINGS_NAME\",\n                    \"value\": \"({documents, events, documentData, user}) => { const rows = (events || []).filter((e) => e.eventTemplateId === 1004002).sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt)); const r = rows[0]?.data?.result?.sendToExternalService?.sendingResult?.response || {}; return { uri: r.offerUri || '', exchangeId: r.exchangeId || '' }; }\"\n                },\n                \"nextStep\": {\n                    \"control\": \"text.block\",\n                    \"htmlBlock\": \"<div style='margin-top:12px;'><p><b>Next step:</b> <a href='/tasks/create/1003/1003001' style='color:#1a56db;text-decoration:underline;'>Educational certificate</a> \\u2014 pay the fee from your wallet and receive your certificate.</p></div>\"\n                }\n            }\n        }\n    }\n}",
