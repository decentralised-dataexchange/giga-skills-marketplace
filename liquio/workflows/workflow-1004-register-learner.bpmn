  {
   "id": 1004002,
   "eventTypeId": 3,
   "name": "Issue Learner Profile",
   "description": "",
   "jsonSchema": {
    "sendToExternalService": {
     "providerName": "igrant",
     "service": "igrant",
     "options": {
      "operation": "() => 'issue'",
      "settingsName": "() => 'REPLACE_WITH_SETTINGS_NAME'",
      "userPin": "() => ''",
      "credentialDefinitionId": "() => 'REPLACE_WITH_LEARNER_PROFILE_DEFINITION_ID'",
      "issuanceMode": "() => 'InTime'",
      "claims": "(document, event, documents, events) => { const doc = (documents || []).find((x) => x.documentTemplateId === 1004004) || {}; const d = doc.data || {}; const p = d.personal || {}; const e = d.enrolment || {}; const ulid = Array.from({ length: 10 }, () => Math.floor(Math.random() * 10)).join(''); return { ulid: ulid, given_name: p.firstName || '', family_name: p.lastName || '', birthdate: p.dateOfBirth || '', id_number: p.idNumber || '', phone: p.phone || '', email: p.email || '', institution: e.institution || '', programme_name: e.programmeName || '' }; }"
     }
    }
   },
   "jsonSchemaRaw": "{\n    \"sendToExternalService\": {\n        \"providerName\": \"igrant\",\n        \"service\": \"igrant\",\n        \"options\": {\n            \"operation\": \"() => 'issue'\",\n            \"settingsName\": \"() => 'REPLACE_WITH_SETTINGS_NAME'\",\n            \"userPin\": \"() => ''\",\n            \"credentialDefinitionId\": \"() => 'REPLACE_WITH_LEARNER_PROFILE_DEFINITION_ID'\",\n            \"issuanceMode\": \"() => 'InTime'\",\n            \"claims\": \"(document, event, documents, events) => { const doc = (documents || []).find((x) => x.documentTemplateId === 1004004) || {}; const d = doc.data || {}; const p = d.personal || {}; const e = d.enrolment || {}; const ulid = Array.from({ length: 10 }, () => Math.floor(Math.random() * 10)).join(''); return { ulid: ulid, given_name: p.firstName || '', family_name: p.lastName || '', birthdate: p.dateOfBirth || '', id_number: p.idNumber || '', phone: p.phone || '', email: p.email || '', institution: e.institution || '', programme_name: e.programmeName || '' }; }\"\n        }\n    }\n}",
   "htmlTemplate": "",
   "createdAt": "2026-08-26T09:00:00.000Z",
   "updatedAt": "2026-08-26T09:00:00.000Z"
  }
