   "jsonSchemaRaw": "{\n    \"sendToExternalService\": {\n        \"providerName\": \"igrant\",\n        \"service\": \"igrant\",\n        \"options\": {\n            \"operation\": \"() => 'verify'\",\n            \"settingsName\": \"() => 'REPLACE_WITH_SETTINGS_NAME'\",\n            \"presentationDefinitionId\": \"() => 'REPLACE_WITH_PID_PRESENTATION_DEFINITION_ID'\"\n        }\n    }\n}",
